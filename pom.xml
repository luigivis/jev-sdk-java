<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.luigivismara</groupId>
  <artifactId>jev-sdk-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>jev-sdk-java</name>
  <description>Type-safe Java client for the TypeSafe AI Jev (System One) decision API</description>
  <url>https://github.com/luigivis/jev-sdk-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>luigivis</id>
      <name>Luigi Vismara</name>
      <url>https://github.com/luigivis</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/luigivis/jev-sdk-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/luigivis/jev-sdk-java.git</developerConnection>
    <url>https://github.com/luigivis/jev-sdk-java</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <source>21</source>
          <doctitle>jev-sdk-java ${project.version}</doctitle>
          <windowtitle>jev-sdk-java ${project.version}</windowtitle>
          <bottom><![CDATA[Unofficial Java client for the TypeSafe AI Jev decision API. MIT licensed.]]></bottom>
          <links>
            <link>https://docs.oracle.com/en/java/javase/21/docs/api/</link>
          </links>
          <!-- Fail the build on broken references or missing @param/@return, so the docs
               cannot rot silently alongside the code. -->
          <doclint>all</doclint>
          <failOnWarnings>true</failOnWarnings>
          <detectJavaApiLink>false</detectJavaApiLink>
          <notimestamp>true</notimestamp>
        </configuration>
        <executions>
          <execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.7.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>false</autoPublish>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Signing lives here so an everyday `mvn package` never touches the GPG key.
         Release with: mvn -Prelease deploy -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- No TTY in CI, so the passphrase has to come in over the pipe. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
